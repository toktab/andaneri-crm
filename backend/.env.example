# Copy to backend/.env for local settings. Real environment variables win over this file.

# --- Database (see db/create-local-database.sql; use the same password you put there)
DB_URL=jdbc:mysql://localhost:3306/andaneri_crm?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=andaneri
DB_PASSWORD=

# --- Sign-in
# Long random string that signs login tokens.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# How long a sign-in lasts, in hours.
TOKEN_HOURS=168

# The first admin, created only when there are no users yet. Change the password after the first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Root account: every permission, and the only one that sees the security centre
# (sign-ins, failed attempts, IPs, every change). Set on every start from these two values;
# changing the password here signs the old root sessions out. Leave empty for no root account.
ROOT_USERNAME=
ROOT_PASSWORD=
# Failed sign-in attempts store the password typed, masked ("p•••d (9)") by default. true keeps the
# full text - often a real password with one typo, so only turn it on if you accept that.
LOG_FULL_FAILED_PASSWORDS=false
# The root account can still sign in from an IP that is not on the whitelist (so it cannot lock itself out).
ROOT_BYPASS_WHITELIST=true
# Behind a reverse proxy (Caddy, nginx) set to native so the real visitor IP is logged, not the proxy's.
FORWARD_HEADERS=none

# --- Test login test / test (admin). Turn off before real use.
TEST_ACCOUNT=true

# --- Frontend: started automatically (vite build --watch) when CrmApplication runs from the IDE.
FRONTEND_AUTOSTART=true
# Where the frontend project is, if not ./frontend or ../frontend.
FRONTEND_DIR=
# A built frontend (dist folder) to serve instead, as the Docker image does.
FRONTEND_DIST=

# --- Other
CRM_ZONE=Asia/Tbilisi
# Example data. Never on the real database.
DEMO_DATA=false
CORS_ORIGINS=
