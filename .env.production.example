# Copy to .env next to docker-compose.yml on the server. Never commit the real file.
# Generate secrets with:  openssl rand -base64 48

# The address people open, pointing (DNS A record) at the server.
DOMAIN=crm.example.ge

# Database
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Signs login tokens. Changing it signs everyone out.
JWT_SECRET=
TOKEN_HOURS=168

# Root: every permission and the security centre. Long, unique, kept in a password manager.
ROOT_USERNAME=
ROOT_PASSWORD=

# First ordinary admin, created once when the database is new. Change its password after signing in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# true stores failed sign-in passwords in full (often a real password with a typo). Default: masked.
LOG_FULL_FAILED_PASSWORDS=false
ROOT_BYPASS_WHITELIST=true
